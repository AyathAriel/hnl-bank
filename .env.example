# === PostgreSQL ===
POSTGRES_USER=hnl
POSTGRES_PASSWORD=hnl_dev_password
POSTGRES_DB=hnl_bank
# Usado por el backend para conectarse (host = nombre del servicio en docker-compose)
DATABASE_URL=postgres://hnl:hnl_dev_password@postgres:5432/hnl_bank?sslmode=disable

# === TigerBeetle ===
TB_CLUSTER_ID=0
TB_ADDRESS=tigerbeetle:3000

# === Auth ===
# Genera uno propio para producción: openssl rand -hex 32
JWT_SECRET=change_me_dev_secret_change_me_dev_secret
JWT_EXPIRY_HOURS=24

# === IA / Chat (Anthropic API directa) ===
# Requerido para que el chat funcione. Obtén una key en https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# === Backend ===
PORT=8080
CORS_ORIGIN=http://localhost:5173

# === Frontend (build-time, solo para `npm run dev` local sin Docker) ===
VITE_API_URL=http://localhost:8080
